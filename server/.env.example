# Client API URL for your Unleash instance, ending in /api (no trailing slash beyond that)
UNLEASH_API_URL=https://your-instance.getunleash.io/api
# Backend token for the development environment
UNLEASH_CLIENT_TOKEN=your-backend-token
# Unleash project the flags live in (defaults to otterbank-demo)
UNLEASH_PROJECT=otterbank-demo
# Frontend origin allowed by CORS
ALLOWED_ORIGIN=http://localhost:5173
# Port the backend listens on
PORT=3001
# Metrics reporting interval in milliseconds, lower it for the live demo so
# the safeguard sees thumbs-down taps within seconds
METRICS_INTERVAL=60000
